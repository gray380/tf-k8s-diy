apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: kbot
  namespace: flux-system
spec:
  interval: 1m
  url: https://github.com/${github_owner}/kbot
  ref:
    branch: develop
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: kbot
  namespace: flux-system
spec:
  interval: 1m
  chart:
    spec:
      chart: ./helm
      sourceRef:
        kind: GitRepository
        name: kbot
      interval: 1m
  values:
    replicaCount: 1
    args:
      - kbot
