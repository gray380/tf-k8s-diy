apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - gotk-components.yaml
  - gotk-sync.yaml
patches:
  - path: kustomize-controller-patch.yaml
    target:
      kind: ServiceAccount
      name: kustomize-controller
  - path: flux-decryption-patch.yaml
    target:
      kind: Kustomization
      name: flux-system
