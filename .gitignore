# Local .terraform directories
**/.terraform/*

# .tfstate files
**/*.tfstate
**/*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
#password, private keys, and other secrets. These should not be part of version 
# control as they are data based configuration and not shared code.
**/*.tfvars
**/*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include lock file for provider consistency
# (Uncomment the line below if you prefer to exclude it)
.terraform.lock.hcl

# Include backend conf file if used
# .terraformrc
# terraform.rc

# Exclude local plans and kubeconfig
**/*.plan
**/*.plan.out
**/kubeconfig
